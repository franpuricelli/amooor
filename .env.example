# ── Convex (WP-2) ────────────────────────────────────────────────────────────
# Deploy key from the Convex dashboard (Settings → Deploy keys). SECRET — set it
# in .env.local (gitignored) locally, and in the hosting provider's env for CI.
CONVEX_DEPLOY_KEY=dev:your-deployment-name|xxxxxxxx
# Public URL of the same deployment (https://<deployment-name>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ── Platform ─────────────────────────────────────────────────────────────────
# Apex domain of the platform; subdomains (<slug>.<APP_DOMAIN>) resolve to tenants.
NEXT_PUBLIC_APP_DOMAIN=amooor.com
# Guards the one-off seed endpoint (app/api/seed). Any random string.
SEED_SECRET=change-me
