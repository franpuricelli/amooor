# ── Convex (WP-2) ────────────────────────────────────────────────────────────
# Deploy key from the Convex dashboard (Settings → Deploy keys). SECRET — set it
# in .env.local (gitignored) locally, and in the hosting provider's env for CI.
CONVEX_DEPLOY_KEY=dev:your-deployment-name|xxxxxxxx
# Public URL of the same deployment (https://<deployment-name>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ── Platform ─────────────────────────────────────────────────────────────────
# Apex domain of the platform; subdomains (<slug>.<APP_DOMAIN>) resolve to tenants.
NEXT_PUBLIC_APP_DOMAIN=amooor.com
# Absolute base URL (used for links in emails, checkout redirects, previews).
NEXT_PUBLIC_APP_URL=https://amooor.com
# Guards the one-off seed endpoint (app/api/seed). Any random string.
SEED_SECRET=change-me
# Guards internal server-to-server calls (/api/generate finalize, webhooks).
INTERNAL_SECRET=change-me

# ── Rebill — payments (WP-4) ─────────────────────────────────────────────────
REBILL_SECRET_KEY=sk_xxx
NEXT_PUBLIC_REBILL_PUBLIC_KEY=pk_xxx
REBILL_WEBHOOK_SECRET=whsec_or_sk_xxx

# ── Cloudflare Images — photo storage (WP-4) ─────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxx
# R2 fallback (S3-compatible) — only if using R2 instead of Images.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# ── Resend — transactional email (WP-4) ──────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM=amooor <onboarding@resend.dev>

# ── Vercel Domains — custom .love domains (WP-4) ─────────────────────────────
VERCEL_TOKEN=vcp_xxx
VERCEL_PROJECT_ID=prj_xxx
VERCEL_TEAM_ID=team_xxx

# ── Namecheap — .love purchase + DNS (WP-4, optional) ────────────────────────
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=

# ── LLM runtime — AI skills (WP-3, optional; falls back to deterministic gen) ─
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── Intake conversacional (chat-first, /comenzar) ────────────────────────────
# El agente del chat usa Kimi K2.6 vía Moonshot directo (mismo KIMI_API_KEY de
# arriba). SECRETO: sólo server-side (nunca en el browser, nunca commiteado).
# KIMI_MODEL = id real de K2.6 en Moonshot (verificado contra /v1/models).
KIMI_MODEL=kimi-k2.6
# Seam del cap de turnos del agente. Vacío/0 = ilimitado (default v0). Si se
# setea a N, al alcanzar N turnos del usuario el agente fuerza el plan.
MAX_USER_TURNS=
# Búsqueda web del agente (built-in $web_search de Moonshot). =0 para apagarla.
KIMI_WEB_SEARCH=
# =1 para que el agente RAZONE de verdad en cada turno (thinking real, LENTO ~1min
# por turno en charla abierta). Default: instant + un paso "Pensando" en el
# timeline (rápido). La síntesis del plan siempre usa thinking (una sola vez).
KIMI_THINK_CONVO=
# Deepgram Nova-3 — STT en vivo del composer. SECRETO server-side: la key real
# nunca llega al browser; /api/deepgram/token mintea un token efímero (~30s).
DEEPGRAM_API_KEY=
# SÓLO DEV: si la key no tiene scope para mintear tokens efímeros (grant/keys),
# poner =1 para servir la key REAL al browser. EXPONE la key: nunca en prod.
DEEPGRAM_ALLOW_RAW_KEY=
# ⚠️ SÓLO DEV/LOCAL. Si tu key de Deepgram es restringida y no puede mintear
# tokens efímeros (grant/keys API sin scope), poné =1 para que /api/deepgram/token
# devuelva la key REAL al browser y el dictado funcione localmente. EXPONE la key:
# dejalo vacío/0 en producción (ahí usá una key con permiso de grant). Rotar la key.
DEEPGRAM_ALLOW_RAW_KEY=
